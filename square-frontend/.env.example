# Copy to .env.local for development, or .env.production before building.
# Both are gitignored — never commit filled-in values.

# Backend API base URL — no trailing slash. Must be https:// in production.
VITE_API_BASE=https://api.example.com

# Password for the seeded demo accounts, used only by the offline demo
# fallback in development. Match it to the backend's DEMO_PASSWORD.
# VITE_DEMO_PASSWORD=

# Leave unset in production. Setting it to "true" turns the seed-data demo
# fallback back on, which HIDES real backend outages behind fake data.
# VITE_ENABLE_DEMO=true
