# Copy to .env (or set these as real environment variables) before running in
# production. .env is gitignored — never commit filled-in values.
#
#   SPRING_PROFILES_ACTIVE=prod ./mvnw spring-boot:run

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_URL=jdbc:postgresql://your-db-host:5432/square_db
DB_USERNAME=square_app
DB_PASSWORD=replace-with-a-strong-generated-password

# --- Frontend origin allowed to call this API (comma-separated for several) ---
CORS_ORIGINS=https://portal.example.com

# --- Optional ---
SERVER_PORT=8080

# --- Development only ---
# Password given to the seeded demo accounts the first time an empty database
# is seeded. Leave unset and one is generated and printed to the console.
# Ignored under the prod profile, which never seeds demo accounts.
# DEMO_PASSWORD=
