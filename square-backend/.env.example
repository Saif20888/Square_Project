# Copy to .env (or set these as real environment variables) before running in
# production. .env is gitignored — never commit filled-in values.
#
#   SPRING_PROFILES_ACTIVE=prod ./mvnw spring-boot:run

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_URL=jdbc:postgresql://your-db-host:5432/square_db
DB_USERNAME=square_app
DB_PASSWORD=replace-with-a-strong-generated-password

# --- Frontend origin allowed to call this API (comma-separated for several) ---
CORS_ORIGINS=https://portal.example.com

# --- Optional ---
SERVER_PORT=8080

# --- Development only ---
# Password given to the seeded demo accounts the first time an empty database
# is seeded. Leave unset and one is generated and printed to the console.
# Ignored under the prod profile, which never seeds demo accounts.
# DEMO_PASSWORD=

# --- Portfolio/demo deployments only — NEVER set on a real production system ---
# Turns the full demo roster (employees, tickets, assets) back on under the
# prod profile, layered on top of whatever ADMIN_USERNAME/ADMIN_PASSWORD
# already created. Off by default.
# ENABLE_DEMO_SEED=true

# Optional per-account overrides so the 4 role demo logins can each have their
# own memorable password instead of sharing DEMO_PASSWORD. Falls back to
# DEMO_PASSWORD for any of these left unset.
# DEMO_PW_RAFIQ=       # Employee dashboard
# DEMO_PW_MANAGER1=    # Superuser dashboard
# DEMO_PW_TECH1=       # IT Team dashboard
# DEMO_PW_ADMIN1=      # System admin dashboard
